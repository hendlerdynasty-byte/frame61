{
  "id": "aniworld",
  "name": "aniworld.to",
  "version": 2,
  "minEngine": "1.0.0",
  "tier": "A",
  "legalFree": false,
  "baseUrl": "https://aniworld.to",
  "kind": "html",
  "search": {
    "endpoint": "/ajax/search",
    "method": "POST",
    "body": "keyword={{query}}",
    "format": "api",
    "jsonPath": ".",
    "idPath": "link",
    "titlePath": "title",
    "pageLimit": 20
  },
  "detail": {
    "endpoint": "/anime/stream/{titleId}",
    "format": "html",
    "resultSelector": "body",
    "titleSelector": "h1"
  },
  "episodes": {
    "endpoint": "/anime/stream/{titleId}",
    "format": "html",
    "episodeSelector": "table.seasonEpisodesList tbody tr",
    "episodeTitleSelector": "td.seasonEpisodeTitle",
    "episodeLinkSelector": "td.seasonEpisodeTitle a",
    "episodeIndexSelector": "td.season1EpisodeID"
  },
  "streams": {
    "endpoint": "/anime/stream/{titleId}/staffel-1/episode-{episodeId}",
    "format": "html",
    "selector": "li[data-link-target]",
    "urlAttr": "data-link-target",
    "langAttr": "data-lang-key",
    "langMap": {
      "1": "de",
      "2": "en",
      "3": "orig"
    },
    "hosterSelector": "h4",
    "referrers": [
      {
        "domain": "aniworld.to",
        "accept": true
      }
    ]
  },
  "verified": true,
  "last_check": "2026-11-22T01:28:51Z",
  "check": {
    "status": "verified",
    "reason": "",
    "checked": [
      "search.jsonPath",
      "search.idPath",
      "search.titlePath",
      "detail.resultSelector",
      "detail.titleSelector",
      "episodes.episodeSelector",
      "episodes.episodeTitleSelector",
      "episodes.episodeLinkSelector",
      "episodes.episodeIndexSelector"
    ],
    "misses": [],
    "http_status": 200
  }
}
