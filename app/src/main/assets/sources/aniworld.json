{
  "id": "aniworld",
  "name": "aniworld.to",
  "version": 3,
  "minEngine": "1.0.0",
  "tier": "A",
  "legalFree": false,
  "baseUrl": "https://aniworld.to",
  "kind": "html",
  "search": {
    "endpoint": "/ajax/search",
    "method": "POST",
    "body": "keyword={{query}}",
    "format": "api",
    "jsonPath": ".",
    "idPath": "link",
    "titlePath": "title",
    "pageLimit": 20
  },
  "detail": {
    "endpoint": "/anime/stream/{titleId}",
    "format": "html",
    "resultSelector": "body",
    "titleSelector": "h1"
  },
  "episodes": {
    "endpoint": "/anime/stream/{titleId}",
    "format": "html",
    "episodeSelector": "table.seasonEpisodesList tbody tr",
    "episodeTitleSelector": "td.seasonEpisodeTitle",
    "episodeLinkSelector": "td.seasonEpisodeTitle a",
    "episodeIndexSelector": "td[class*=\"EpisodeID\"]"
  },
  "streams": {
    "endpoint": "/anime/stream/{titleId}/staffel-{season}/episode-{episodeId}",
    "format": "html",
    "selector": "li[data-link-target]",
    "urlAttr": "data-link-target",
    "langAttr": "data-lang-key",
    "langMap": {
      "1": "de",
      "2": "en",
      "3": "orig"
    },
    "hosterSelector": "h4",
    "referrers": [
      {
        "domain": "aniworld.to",
        "accept": true
      }
    ]
  },
  "verified": true,
  "last_check": "2026-11-26T20:23:16Z",
  "check": {
    "status": "verified",
    "reason": "A52 Build c70a9ac: 20/20 Titel korrekt gespielt, Identität bestätigt, lokale Poster/Backdrops und Detailmetadaten, Staffel/Folgenadressierung quellbelegt",
    "checked": ["search", "detail", "episodes", "streams", "identity", "playback"],
    "misses": [],
    "http_status": 200
  }
}
