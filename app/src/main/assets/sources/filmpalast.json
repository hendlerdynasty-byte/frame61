{
  "id": "filmpalast",
  "name": "Filmpalast",
  "version": 2,
  "minEngine": "1.0.0",
  "tier": "A",
  "legalFree": false,
  "baseUrl": "https://filmpalast.to",
  "kind": "html",
  "search": {
    "endpoint": "/search/title/{query}",
    "format": "html",
    "resultSelector": "article.liste",
    "titleSelector": "h2 a",
    "linkSelector": "h2 a",
    "idAttr": "href",
    "pageLimit": 20
  },
  "detail": {
    "endpoint": "/stream/{titleId}",
    "format": "html",
    "resultSelector": "body",
    "titleSelector": "[itemprop=\"name\"]"
  },
  "streams": {
    "endpoint": "/stream/{titleId}",
    "format": "html",
    "selector": "ul.currentStreamLinks a.iconPlay",
    "urlAttr": "href",
    "referrers": [
      {
        "domain": "filmpalast.to",
        "accept": true
      }
    ]
  },
  "verified": true,
  "last_check": "2026-11-22T01:28:55Z",
  "check": {
    "status": "verified",
    "reason": "",
    "checked": [
      "search.resultSelector",
      "search.titleSelector",
      "search.linkSelector",
      "detail.resultSelector",
      "detail.titleSelector",
      "streams.selector",
      "streams.urlAttr"
    ],
    "misses": [],
    "http_status": 200
  }
}
