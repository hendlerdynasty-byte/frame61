{
  "id": "plex-free",
  "name": "Plex Free",
  "version": 1,
  "minEngine": "1.0.0",
  "tier": "C",
  "legalFree": true,
  "baseUrl": "https://www.plex.tv",
  "search": {
    "endpoint": "/suche/{query}",
    "queryParam": null,
    "resultSelector": ".film-item",
    "titleSelector": "h3 a",
    "yearSelector": ".jahr",
    "typeSelector": ".free-badge",
    "pageLimit": 20
  },
  "detail": {
    "endpoint": "/film/{titleId}",
    "episodeSelector": ".episode-list .episode",
    "seasonSelector": ".season-tab",
    "episodeTitleSelector": "a",
    "episodeLinkSelector": "a",
    "episodeIndexSelector": null
  },
  "streams": {
    "selector": ".stream-item a",
    "urlAttr": "href",
    "qualitySelector": ".quality",
    "langSelector": ".language",
    "hosterSelector": ".hoster",
    "healthAttr": "data-health",
    "minHealth": 0.7,
    "qualityMap": { "HD": "1080", "FHD": "1080", "SD": "720" },
    "langMap": { "DE": "de", "EN": "en", "OmU": "de" },
    "referrers": [
      { "domain": "plex.tv", "accept": true }
    ]
  }
}
