{
  "id": "vidoza",
  "name": "Vidoza",
  "version": 1,
  "verified": false,
  "domains": [
    "vidoza.net"
  ],
  "result": "file",
  "steps": [
    {
      "action": "get",
      "url": "https://{host}{path}",
      "saveAs": "page"
    },
    {
      "action": "regex",
      "input": "page",
      "pattern": "sources: \\[\\{file:\\s*\"([^\"]+)\"",
      "group": 1,
      "saveAs": "file"
    }
  ]
}
