{
  "id": "filemoon",
  "name": "Filemoon",
  "version": 4,
  "verified": true,
  "domains": [
    "filemoon.to",
    "filemoon.sx",
    "bysezejataos.com",
    "n1mwq.org"
  ],
  "result": "file",
  "steps": [
    {
      "action": "copy",
      "url": "{path}",
      "saveAs": "pagePath"
    },
    {
      "action": "regex",
      "input": "pagePath",
      "pattern": "/d/([A-Za-z0-9]+)",
      "group": 1,
      "saveAs": "code"
    },
    {
      "action": "get",
      "url": "https://{host}/api/videos/{code}",
      "saveAs": "video"
    },
    {
      "action": "aesgcm",
      "input": "video",
      "saveAs": "sources"
    },
    {
      "action": "json",
      "input": "sources",
      "path": "sources.0.url",
      "saveAs": "file"
    }
  ],
  "last_check": "2026-11-24T05:17:47Z",
  "check": {
    "status": "verified",
    "reason": "GET /api/videos/{code} liefert den playback-Block (AES-256-GCM); nach der Entschluesselung steht die m3u8 (HTTP 200, application/vnd.apple.mpegurl)",
    "checked": [
      "aesgcm",
      "json:sources.0.url"
    ],
    "misses": [],
    "http_status": 200
  }
}
